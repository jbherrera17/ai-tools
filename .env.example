# AIDigest Environment Variables
# Copy this to .env and fill in your values

# Supabase Configuration
# Get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Enable database mode (set to 'true' to use Supabase instead of hardcoded feeds)
USE_DATABASE=false

# Admin API Token (optional - leave blank for dev mode with no auth)
# In production, set this to a secure random string
ADMIN_API_TOKEN=

# Anthropic API Key — digest (api/summarize.py) + AI Gateway BYOK for Claude.
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional provider keys for AI Gateway BYOK (Higgins chat / depts / embeddings).
# When set, Gateway uses these instead of a shared AI_GATEWAY_API_KEY.
OPENAI_API_KEY=
XAI_API_KEY=
# Either of these works for Gemini BYOK:
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# ============================================
# Higgins 2.0 (REQ-002)
# ============================================

# Vercel AI Gateway — for local/dev (`vercel dev`). On Vercel, remove a
# stale/shared key so this project's OIDC is used instead.
AI_GATEWAY_API_KEY=

# Chat + dept models (AI Gateway strings). Must be catalog IDs from
# api/lib/modelCatalog.ts. Digest stays on the Anthropic SDK (not Gateway).
HIGGINS_MODEL=anthropic/claude-opus-5
DEPT_MODEL=anthropic/claude-sonnet-5
DIGEST_MODEL=claude-sonnet-4-5-20250929

# Shared bearer token for /api/chat. Single-user (JB-only) gate for v1.
# Generate with: openssl rand -hex 32
HIGGINS_API_TOKEN=

# Vercel Blob — required for Phase 4 (DocX/PPTX server-rendered artifacts).
# Provisioned via Vercel Storage → Blob.
BLOB_READ_WRITE_TOKEN=
