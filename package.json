{
  "name": "ai-tools",
  "version": "0.1.0",
  "private": true,
  "description": "AI.JBHerrera multi-tool web app — Higgins 2.0 chat + artifacts, AI digest, AI stack, skills library, CA bill tracker.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke:higgins-repo": "tsx scripts/smoke-higgins-repo.ts",
    "smoke:higgins-prompt": "tsx scripts/smoke-higgins-prompt.ts",
    "sync-skills": "python3 scripts/sync_skills.py",
    "sync-skills:dry": "python3 scripts/sync_skills.py --dry-run",
    "dev:start": "vercel dev --listen 3000",
    "dev:stop": "scripts/kill-dev.sh",
    "dev:restart": "scripts/kill-dev.sh && vercel dev --listen 3000"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/blob": "^0.27.0",
    "@vercel/node": "^3.2.0",
    "ai": "^6.0.0",
    "docx": "^9.6.1",
    "pdf-parse": "^1.1.4",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
